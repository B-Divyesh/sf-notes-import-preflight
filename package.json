{
  "name": "notes-import-preflight-site",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "test": "vitest run && cargo test --workspace",
    "typecheck": "tsc --noEmit",
    "build:site": "vite build --config site/vite.config.ts",
    "build:cli": "cargo build --release -p notes-preflight && node scripts/copy-cli.mjs",
    "build": "npm run typecheck && npm run build:site && npm run build:cli"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@fontsource/atkinson-hyperlegible": "^5.2.7",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
